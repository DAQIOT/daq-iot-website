  },
  "dependencies": {
    "astro": "^6.4.2",
    "@astrojs/sitemap": "^3.7.3",
    "@tailwindcss/vite": "^4.3.0",
    "tailwindcss": "^4.3.0"
  },
  "devDependencies": {
    "decap-server": "^3.11.0"
  },
  "overrides": {
    "vite": "^7"
  }
}
