{
  "name": "foreign-trade-i18n",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "cms": "npx decap-server",
    "dev:cms": "start /b npx decap-server && astro dev",
    "check:images": "node scripts/check-images.cjs",
    "audit:media": "node scripts/audit-media.cjs",
