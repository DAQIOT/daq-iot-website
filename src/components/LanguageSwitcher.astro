---
// 语言切换（下拉式）：🌐 当前语言名 + 箭头，点击展开菜单，当前语言高亮
import { locales } from '../i18n/config';
import { stripLang } from '../i18n/utils';
import type { Lang } from '../i18n/config';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const pathname = Astro.url.pathname;
const pure = stripLang(pathname, lang);
const suffix = pure === '/' ? '/' : pure;

// 菜单内语言自称：始终以该语言原文展示
const NAMES: Record<Lang, string> = { zh: '简体中文', en: 'English', de: 'Deutsch' };
const links = locales.map((code) => ({
  code,
  label: NAMES[code],
  href: '/' + code + suffix,
  active: lang === code,
}));
const current = NAMES[lang];
---
<div class="relative" data-lang-switcher>
  <button
    type="button"
    class="flex items-center gap-1.5 border border-slate-200 rounded-md px-2.5 py-1.5 text-sm text-slate-700 hover:border-brand hover:text-brand transition"
    aria-haspopup="listbox"
    aria-expanded="false"
    aria-label="切换语言"
  >
    <svg class="w-4 h-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true">
      <circle cx="12" cy="12" r="9"></circle>
      <path d="M3 12h18M12 3c2.6 2.6 3.9 5.7 3.9 9s-1.3 6.4-3.9 9c-2.6-2.6-3.9-5.7-3.9-9S9.4 5.6 12 3z" stroke-linecap="round" stroke-linejoin="round"></path>
    </svg>
    <span data-lang-label>{current}</span>
    <svg data-lang-chevron class="w-3 h-3 transition-transform" viewBox="0 0 12 12" fill="none" aria-hidden="true">
      <path d="M3 4.5 6 7.5 9 4.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path>
    </svg>
  </button>

  <div data-lang-menu class="hidden absolute right-0 top-full mt-2 w-36 bg-white rounded-lg shadow-xl border border-slate-100 py-1 z-50">
    {links.map((l) => (
      <a
        href={l.href}
        hreflang={l.code}
        class:list={[
          'block px-4 py-2 text-sm transition',
          l.active ? 'bg-brand text-white font-medium' : 'text-slate-700 hover:bg-brand-light hover:text-brand',
        ]}
      >{l.label}</a>
    ))}
  </div>
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-lang-switcher]').forEach((box) => {
    const btn = box.querySelector('button');
    const menu = box.querySelector<HTMLElement>('[data-lang-menu]');
    const chevron = box.querySelector<HTMLElement>('[data-lang-chevron]');
    if (!btn || !menu) return;

    const close = () => {
      menu.classList.add('hidden');
      btn.setAttribute('aria-expanded', 'false');
      chevron?.classList.remove('rotate-180');
    };

    btn.addEventListener('click', (e) => {
      e.stopPropagation();
      const willOpen = menu.classList.contains('hidden');
      // 同时只开一个（页面上若出现多个切换器互不干扰）
      document.querySelectorAll<HTMLElement>('[data-lang-menu]').forEach((m) => { if (m !== menu) m.classList.add('hidden'); });
      document.querySelectorAll('[data-lang-switcher] button').forEach((b) => b.setAttribute('aria-expanded', 'false'));
      document.querySelectorAll<HTMLElement>('[data-lang-chevron]').forEach((c) => c.classList.remove('rotate-180'));
      menu.classList.toggle('hidden', !willOpen);
      btn.setAttribute('aria-expanded', String(willOpen));
      chevron?.classList.toggle('rotate-180', willOpen);
    });

    document.addEventListener('click', (e) => {
      if (!box.contains(e.target as Node)) close();
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') close();
    });
  });
</script>
