const INTL_ORDER: Intl[] = ['facebook', 'instagram', 'tiktok', 'linkedin', 'youtube', 'whatsapp'];
const CN_ORDER: Cn[] = ['wechat', 'douyin', 'channels', 'bilibili', 'zhihu', 'toutiao'];

const isZh = lang === 'zh';
const CAP_SCAN = isZh ? '扫码查看' : lang === 'de' ? 'Zum Scannen' : 'Scan to view';
const CAP_CLICK = isZh ? '点击查看' : lang === 'de' ? 'Zum Ansehen' : 'Click to view';

// 只接受 http(s) 完整链接；WhatsApp 允许直接填号码 → wa.me
function resolveUrl(raw: unknown, platform: string): string {
  const v = String(raw ?? '').trim();
  if (!v) return '';
  if (/^https?:\/\//i.test(v)) return v;
  if (platform === 'whatsapp') {
    const digits = v.replace(/\D/g, '');
    return digits.length >= 6 ? 'https://wa.me/' + digits : '';
  }
  return '';
}

// 二维码图片：接受站内路径或 http(s) 图片地址
function resolveQr(raw: unknown): string {
  const v = String(raw ?? '').trim();
  if (!v) return '';
  return /^https?:\/\//i.test(v) || v.startsWith('/') ? v : '';
}

const intlItems = INTL_ORDER.map((platform) => ({
  platform, ...INTL[platform], href: resolveUrl(social?.[platform], platform)
})).filter((i) => i.href);

const cnItems = CN_ORDER.map((platform) => {
  const cfg = (social?.[platform] ?? {}) as Record<string, unknown>;
  const href = resolveUrl(cfg.url, platform);
  const qr = resolveQr(cfg.qr);
  // 无链接只有二维码时，点击打开二维码大图
  return { platform, ...CN[platform], href: href || qr, qr, hrefIsQrOnly: !href && !!qr };
}).filter((i) => i.href);

const items = [...intlItems, ...cnItems];
const showTitle = !!follow && items.length > 0;
---
{items.length > 0 && (
  <div class:list={['social-links', klass]}>
    {showTitle && (
      <div class="mb-2.5 text-[11px] font-semibold uppercase tracking-[0.14em] text-slate-500">{follow}</div>
    )}
    {intlItems.length > 0 && (
      <div class="flex flex-wrap items-center gap-1.5">
        {intlItems.map((i) => (
          <a
            href={i.href}
            target="_blank"
            rel="noopener noreferrer nofollow"
            aria-label={isZh ? i.labelZh : i.label}
            title={isZh ? i.labelZh : i.label}
            class="social-link"
            style={`--sc:${i.color}`}
          >
            <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d={i.path} />
            </svg>
          </a>
        ))}
      </div>
    )}
    {cnItems.length > 0 && (
      <div class:list={['flex flex-wrap items-center gap-1.5', intlItems.length > 0 && 'mt-1.5']}>
        {cnItems.map((i) => (
          <a
            href={i.href}
            target="_blank"
            rel="noopener noreferrer nofollow"
            aria-label={isZh ? i.labelZh : i.label}
            class="cn-link"
            style={`--sc:${i.color}`}
          >
            <svg viewBox={i.viewBox} fill="currentColor" fill-rule="evenodd" aria-hidden="true">
              {i.paths.map((d) => <path d={d} />)}
            </svg>
            {i.qr ? (
              <span class="pop">
                <img src={i.qr} alt="" loading="lazy" width="120" height="120" />
                <span class="cap">{CAP_SCAN}</span>
              </span>
            ) : (
              <span class="pop pop-text">{CAP_CLICK}</span>
            )}
          </a>
        ))}
      </div>
    )}
  </div>
)}

