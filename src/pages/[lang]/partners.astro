---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getTranslations, getSiteData, getPageTags } from '../../i18n/utils';
import type { Lang } from '../../i18n/config';
import PageHero from '../../components/PageHero.astro';
import PageTagCards from '../../components/PageTagCards.astro';

export function getStaticPaths() {
  return (['en', 'zh', 'de'] as Lang[]).map((lang) => ({ params: { lang } }));
}
const { lang } = Astro.params as { lang: Lang };
const t = await getTranslations(lang);
const site = await getSiteData(lang);
const base = '/' + lang;

// 页面横幅背景图（后台「网站基础文案 → 页面横幅背景图」配置，留空用默认渐变纹理）
const bannerImage = ((site.banner?.partnersPageImage as string) || (site.banner?.pageImage as string) || '');

// 合作类型列表 = 标签；本页卡片**不可点开**（expandable={false}）：
// 第一张是跳转卡片（去「加入我们」），另外两张只做说明，不在下方展开案例。
const tags = await getPageTags(lang, 'partners');
// 资料中心卡片：带 link 的（产品彩页 → 产品中心、认证证书 → 荣誉资质、白皮书 → 解决方案）整块可点跳转
const resources = (site.partners?.resources ?? []).map((it: { title: string; desc: string; link?: string }) => ({
  title: it.title,
  desc: it.desc,
  link: String(it.link ?? '').trim()
}));
---
<BaseLayout lang={lang} title={t('partners.title') + ' | DAQ-IOT'} description={t('partners.subtitle')}>
  <PageHero title={t('partners.title')} subtitle={t('partners.subtitle')} image={bannerImage} />

  <section class="mx-auto max-w-[1600px] px-4 lg:px-8 py-16">
    <!-- 合作类型卡片：本页统一不可展开（expandable={false}）——第一张跳「加入我们」，另外两张纯说明 -->
    <PageTagCards lang={lang} page="partners" tags={tags} variant="sm" expandable={false} />
  </section>

  <section class="bg-slate-50 border-y border-slate-100">
    <div class="mx-auto max-w-[1600px] px-4 lg:px-8 py-16">
      <div class="text-center mb-12">
        <h2 class="text-3xl font-bold text-brand-dark">{t('partners.resourcesTitle')}</h2>
        <p class="mt-3 text-slate-500">{t('partners.resourcesSubtitle')}</p>
      </div>
      <div class="grid sm:grid-cols-3 gap-6">
        {resources.map((it) =>
          it.link ? (
            <a href={base + it.link} class="group block bg-white border border-slate-200 rounded-2xl p-8 card-hover">
              <h3 class="flex items-center gap-2 text-lg font-semibold text-brand-dark">
                <span>{it.title}</span>
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" class="shrink-0 text-brand transition group-hover:translate-x-0.5" aria-hidden="true">
                  <line x1="5" y1="12" x2="19" y2="12"></line>
                  <polyline points="12 5 19 12 12 19"></polyline>
                </svg>
              </h3>
              <p class="mt-2 text-slate-600 text-sm leading-relaxed">{it.desc}</p>
            </a>
          ) : (
            <div class="bg-white border border-slate-200 rounded-2xl p-8 card-hover">
              <h3 class="text-lg font-semibold text-brand-dark">{it.title}</h3>
              <p class="mt-2 text-slate-600 text-sm leading-relaxed">{it.desc}</p>
            </div>
          )
        )}
      </div>
    </div>
  </section>

  <div class="text-center pb-16">
    <a href={base + '/contact'} class="inline-block bg-brand text-white px-7 py-3 rounded-md font-medium hover:bg-brand-dark transition">{t('nav.cta')}</a>
  </div>
</BaseLayout>
