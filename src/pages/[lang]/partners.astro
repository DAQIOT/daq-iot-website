---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getTranslations, getSiteData } from '../../i18n/utils';
import type { Lang } from '../../i18n/config';
import PageHero from '../../components/PageHero.astro';

export function getStaticPaths() {
  return (['en', 'zh', 'de'] as Lang[]).map((lang) => ({ params: { lang } }));
}
const { lang } = Astro.params as { lang: Lang };
const t = await getTranslations(lang);
const site = await getSiteData(lang);
const base = '/' + lang;

// 页面横幅背景图（后台「网站基础文案 → 页面横幅背景图」配置，留空用默认渐变纹理）
const bannerImage = (site.banner?.pageImage as string) || '';

const items = (site.partners?.items ?? []).map((it: { title: string; desc: string }) => ({ title: it.title, desc: it.desc }));
const resources = (site.partners?.resources ?? []).map((it: { title: string; desc: string }) => ({ title: it.title, desc: it.desc }));
---
<BaseLayout lang={lang} title={t('partners.title') + ' | DAQ-IOT'} description={t('partners.subtitle')}>
  <PageHero title={t('partners.title')} subtitle={t('partners.subtitle')} image={bannerImage} />

  <section class="mx-auto max-w-[1600px] px-4 lg:px-8 py-16">
    <div class="grid sm:grid-cols-3 gap-6">
      {items.map((it) => (
        <div class="bg-white border border-slate-200 rounded-2xl p-8 card-hover">
          <h3 class="text-lg font-semibold text-brand-dark">{it.title}</h3>
          <p class="mt-2 text-slate-600 text-sm leading-relaxed">{it.desc}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="bg-slate-50 border-y border-slate-100">
    <div class="mx-auto max-w-[1600px] px-4 lg:px-8 py-16">
      <div class="text-center mb-12">
        <h2 class="text-3xl font-bold text-brand-dark">{t('partners.resourcesTitle')}</h2>
        <p class="mt-3 text-slate-500">{t('partners.resourcesSubtitle')}</p>
      </div>
      <div class="grid sm:grid-cols-3 gap-6">
        {resources.map((it) => (
          <div class="bg-white border border-slate-200 rounded-2xl p-8 card-hover">
            <h3 class="text-lg font-semibold text-brand-dark">{it.title}</h3>
            <p class="mt-2 text-slate-600 text-sm leading-relaxed">{it.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <div class="text-center mt-12">
    <a href={base + '/contact'} class="inline-block bg-brand text-white px-7 py-3 rounded-md font-medium hover:bg-brand-dark transition">{t('nav.cta')}</a>
  </div>
</BaseLayout>
