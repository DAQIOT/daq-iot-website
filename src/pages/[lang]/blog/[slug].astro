---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getTranslations, getSiteData } from '../../../i18n/utils';
import type { Lang } from '../../../i18n/config';
import { getCollection, render } from 'astro:content';
import PageHero from '../../../components/PageHero.astro';

export async function getStaticPaths() {
  const posts = await getCollection('posts');
  return posts.map((entry) => {
    const [lang, ...slugParts] = entry.id.split('/');
    const slug = slugParts.join('/');
    return {
      params: { lang, slug },
      props: { entry },
    };
  });
}

const { lang, slug } = Astro.params as { lang: Lang; slug: string };
const { entry } = Astro.props;
const t = await getTranslations(lang);
const { Content } = await render(entry);
const listHref = '/' + lang + '/blog';

function fmt(d: string | undefined) {
  return d ? d : '';
}

const site = await getSiteData(lang);
const bannerImage = (site.banner?.pageImage as string) || '';
---
<BaseLayout lang={lang} title={entry.data.title + ' | DAQ-IOT'} description={entry.data.description}>
  <PageHero title={entry.data.title} image={bannerImage} size="sm" width="narrow">
    <nav slot="breadcrumb" class="text-sm text-slate-400 mb-3">
      <a href={listHref} class="hover:text-brand">{t('nav.blog')}</a>
    </nav>
    {entry.data.pubDate && <p class="mt-2 text-slate-300 text-sm">{fmt(entry.data.pubDate)}</p>}
  </PageHero>

  <section class="mx-auto max-w-6xl px-4 py-12">
    <article class="border-t border-slate-200 pt-8 text-slate-700 leading-relaxed space-y-4 prose max-w-none">
      <Content />
    </article>
  </section>
</BaseLayout>
