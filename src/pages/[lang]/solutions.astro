---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getTranslations, getSiteData, getAllCases, getPageTags } from '../../i18n/utils';
import type { Lang } from '../../i18n/config';
import PageHero from '../../components/PageHero.astro';
import PageTagCards from '../../components/PageTagCards.astro';

export function getStaticPaths() {
  return (['en', 'zh', 'de'] as Lang[]).map((lang) => ({ params: { lang } }));
}
const { lang } = Astro.params as { lang: Lang };
const t = await getTranslations(lang);
const site = await getSiteData(lang);
const base = '/' + lang;

// 页面横幅背景图（后台「网站基础文案 → 页面横幅背景图」配置，留空用默认渐变纹理）
const bannerImage = ((site.banner?.solutionsImage as string) || (site.banner?.pageImage as string) || '');

// 页面卡片 = 标签（点卡片展开对应案例）
const tags = await getPageTags(lang, 'solutions');
const cases = await getAllCases(lang);
---
<BaseLayout lang={lang} title={t('solutions.title') + ' | DAQ-IOT'} description={t('solutions.subtitle')}>
  <PageHero title={t('solutions.title')} subtitle={t('solutions.subtitle')} image={bannerImage} />

  <section class="mx-auto max-w-[1600px] px-4 lg:px-8 py-16">
    <p class="text-slate-600 max-w-3xl mb-10">{t('solutions.p1')}</p>

    <!-- 方案卡片 = 标签：点卡片展开该分类下的案例 -->
    <PageTagCards lang={lang} page="solutions" tags={tags} cases={cases} variant="lg" />

    <div class="text-center mt-12">
      <a href={base + '/contact'} class="inline-block bg-brand text-white px-7 py-3 rounded-md font-medium hover:bg-brand-dark transition">{t('nav.cta')}</a>
    </div>
  </section>
</BaseLayout>
