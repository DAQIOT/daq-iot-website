---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getTranslations, getSiteData } from '../../i18n/utils';
import { renderMarkdown } from '../../lib/renderMarkdown';
import type { Lang } from '../../i18n/config';

export function getStaticPaths() {
  return (['en', 'zh', 'de'] as Lang[]).map((lang) => ({ params: { lang } }));
}
const { lang } = Astro.params as { lang: Lang };
const t = await getTranslations(lang);
const about = ((await getSiteData(lang)).about ?? {}) as Record<string, any>;

const p1 = await renderMarkdown(t('about.p1') || '');
const p2 = await renderMarkdown(t('about.p2') || '');

// p3 中可能内嵌证书图片，拆出来单独排版，正文只保留文字
const rawP3 = (t('about.p3') || '') as string;
const imgRegex = /!\[([^\]]*)\]\(([^)]+)\)/g;
const p3Images: { alt: string; src: string }[] = [];
const p3TextRaw = rawP3
  .replace(imgRegex, (_m, alt: string, src: string) => {
    p3Images.push({ alt: alt || '', src });
    return '';
  })
  .trim();
const p3 = p3TextRaw ? await renderMarkdown(p3TextRaw) : '';

const title = t('about.title');
const desc = t('about.p1') || '';
const honorTitle = (about.honorTitle as string) || '';
const officesTitle = (about.officesTitle as string) || '';
const offices = (about.offices ?? []) as { name?: string; address?: string }[];
---
<BaseLayout lang={lang} title={title + ' | DAQ-IOT'} description={desc}>
  <!-- 单栏宽版：正文 + 荣誉资质 + 服务网点，纵向铺开 -->
  <section class="mx-auto max-w-6xl px-4 lg:px-8 py-14 lg:py-20">
    <h1 class="text-4xl md:text-5xl font-bold text-slate-900">{title}</h1>
    <div class="mt-5 h-1 w-16 rounded-full bg-brand"></div>

    <!-- 公司简介 -->
    <div class="mt-10 space-y-5 text-lg md:text-xl text-slate-600 leading-relaxed [&_img]:rounded-xl [&_img]:my-6" set:html={p1} />
    <div class="mt-4 text-lg md:text-xl text-slate-600 leading-relaxed [&_img]:rounded-xl [&_img]:my-6" set:html={p2} />

    <!-- 使命 / 愿景 / 价值观 -->
    {p3 && (
      <div class="mt-10 rounded-2xl border border-slate-200 border-l-4 border-l-brand bg-slate-50/70 p-6 md:p-8 text-base md:text-lg text-slate-600 leading-relaxed [&_p]:mt-4 [&_p:first-child]:mt-0 [&_strong]:text-slate-900" set:html={p3} />
    )}

    <!-- 荣誉资质 -->
    {p3Images.length > 0 && honorTitle && (
      <section class="mt-14">
        <h2 class="text-2xl md:text-3xl font-bold text-slate-900">{honorTitle}</h2>
        <div class="mt-6 grid gap-6 sm:grid-cols-2">
          {p3Images.map((img) => (
            <figure class="rounded-2xl border border-slate-200 bg-white p-4 shadow-sm">
              <img src={img.src} alt={img.alt} loading="lazy" class="w-full rounded-xl object-contain" />
              {img.alt && <figcaption class="mt-3 text-sm text-slate-500 text-center">{img.alt}</figcaption>}
            </figure>
          ))}
        </div>
      </section>
    )}

    <!-- 服务网点 -->
    {offices.length > 0 && officesTitle && (
      <section class="mt-14">
        <h2 class="text-2xl md:text-3xl font-bold text-slate-900">{officesTitle}</h2>
        <div class="mt-6 grid gap-4 sm:grid-cols-2">
          {offices.map((o) => (
            <div class="rounded-2xl border border-slate-200 bg-white p-5">
              <div class="font-semibold text-slate-900">{o.name}</div>
              <p class="mt-2 text-sm text-slate-500 leading-relaxed">{o.address}</p>
            </div>
          ))}
        </div>
      </section>
    )}
  </section>
</BaseLayout>
