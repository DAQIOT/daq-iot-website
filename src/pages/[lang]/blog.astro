---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getTranslations, getSiteData } from '../../i18n/utils';
import type { Lang } from '../../i18n/config';
import { getCollection } from 'astro:content';
import PageHero from '../../components/PageHero.astro';

export function getStaticPaths() {
  return (['en', 'zh', 'de'] as Lang[]).map((lang) => ({ params: { lang } }));
}
const { lang } = Astro.params as { lang: Lang };
const t = await getTranslations(lang);
const site = await getSiteData(lang);
const base = '/' + lang;

// 页面横幅背景图（后台「网站基础文案 → 页面横幅背景图」配置，留空用默认渐变纹理）
const bannerImage = (site.banner?.pageImage as string) || '';

const posts = (await getCollection('posts', (entry) => entry.id.startsWith(lang + '/')))
  .sort((a, b) => (b.data.pubDate ?? '').localeCompare(a.data.pubDate ?? ''));

function fmt(d: string | undefined) {
  return d ? d : '';
}
---
<BaseLayout lang={lang} title={t('blog.title') + ' | DAQ-IOT'} description={t('blog.subtitle')}>
  <PageHero title={t('blog.title')} subtitle={t('blog.subtitle')} image={bannerImage} />

  <section class="mx-auto max-w-[1600px] px-4 lg:px-8 py-10">
    {posts.length === 0 ? (
      <p class="text-slate-500 py-12 text-center">—</p>
    ) : (
      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-7">
        {posts.map((p) => (
          <a href={'/' + lang + '/blog/' + p.id.split('/').slice(1).join('/')}
             class="block bg-white border border-slate-200 rounded-2xl overflow-hidden hover:shadow-lg transition">
            {p.data.image && <img src={p.data.image} alt={p.data.title} class="w-full h-48 object-cover bg-slate-50" />}
            <div class="p-6">
              <p class="text-xs text-slate-400">{fmt(p.data.pubDate)}</p>
              <h3 class="mt-2 text-xl font-semibold text-brand-dark">{p.data.title}</h3>
              <p class="mt-2 text-slate-600 text-sm leading-relaxed line-clamp-3">{p.data.description}</p>
            </div>
          </a>
        ))}
      </div>
    )}
  </section>
</BaseLayout>
