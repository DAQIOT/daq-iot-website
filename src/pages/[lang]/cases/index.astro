---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getTranslations, getSiteData } from '../../../i18n/utils';
import { industryKey, localizeIndustry } from '../../../i18n/industry';
import type { Lang } from '../../../i18n/config';
import { getCollection } from 'astro:content';
import PageHero from '../../../components/PageHero.astro';

export function getStaticPaths() {
  return (['en', 'zh', 'de'] as Lang[]).map((lang) => ({ params: { lang } }));
}
const { lang } = Astro.params as { lang: Lang };
const t = await getTranslations(lang);
const site = await getSiteData(lang);
const base = '/' + lang;
// 页面横幅背景图（后台「网站基础文案 → 页面横幅背景图」配置，留空用默认渐变纹理）
const bannerImage = (site.banner?.pageImage as string) || '';

const all = await getCollection('cases', (entry) => entry.id.startsWith(lang + '/') && !entry.data.hidden);
const cases = all.sort((a, b) => (a.data.order ?? 0) - (b.data.order ?? 0));

// 按行业生成筛选标签：industry 先归一化成 key，标签文案按当前语言输出
// （内容里中英文混写的老数据会自动合并成同一个标签，英文/德文站显示对应语言）
const industryMap = new Map<string, string>();
cases.forEach((c) => {
  const key = industryKey(c.data.industry);
  if (key && !industryMap.has(key)) industryMap.set(key, localizeIndustry(c.data.industry, lang));
});
const cats = [...industryMap].map(([key, label]) => ({ key, label }));
const defaultCat = cats[0]?.key ?? '';
const activeCat = Astro.url.searchParams.get('cat') || defaultCat;
---
<BaseLayout lang={lang} title={t('nav.cases') + ' | DAQ-IOT'} description={t('nav.cases')}>
  <PageHero
    title={t('nav.cases')}
    subtitle={`DAQ-IOT ${t('nav.cases')} — Industrial IoT data acquisition & monitoring deployment stories across smart manufacturing and new energy.`}
    image={bannerImage}
  />

  <section class="mx-auto max-w-[1600px] px-4 lg:px-8 py-12">
    {cases.length === 0 ? (
      <p class="text-slate-500 py-12 text-center">暂无案例，欢迎在后台「项目案例」中添加。</p>
    ) : (
      <div class="flex flex-col md:flex-row gap-8 lg:gap-12 items-start">
        <!-- 行业侧栏（竖排） -->
        <aside class="w-full md:w-56 md:shrink-0 md:sticky md:top-24">
          <div class="md:bg-white md:border md:border-slate-200 md:rounded-2xl md:shadow-sm md:p-3">
            <div class="hidden md:block px-3 pt-1 pb-2 text-xs font-semibold text-slate-400 uppercase tracking-wider">
              {lang === 'zh' ? '行业分类' : lang === 'de' ? 'Branchen' : 'Industries'}
            </div>
            <div class="flex flex-wrap md:flex-col gap-1.5" id="caseCatFilter">
              {cats.map((c) => (
                <button type="button" data-cat={c.key}
                  class={`case-cat-btn w-full text-left px-3 py-2 rounded-lg text-sm font-medium transition ${
                    activeCat === c.key
                      ? 'bg-brand text-white shadow-sm'
                      : 'text-slate-600 hover:bg-slate-100 hover:text-brand'
                  }`}>
                  {c.label}
                </button>
              ))}
            </div>
          </div>
        </aside>

        <!-- 案例网格 -->
        <div class="flex-1 min-w-0">
          <div class="grid md:grid-cols-2 xl:grid-cols-3 gap-7" id="caseGrid">
            {cases.map((c) => (
              <a href={'/' + lang + '/cases/' + c.id.split('/').slice(1).join('/')}
                 data-industry={industryKey(c.data.industry)}
                 class="case-card card-hover block bg-white border border-slate-200 rounded-2xl overflow-hidden">
                {c.data.image && <img src={c.data.image} alt={c.data.title} class="w-full h-48 object-cover bg-slate-50" />}
                <div class="p-6">
                  {c.data.industry && (
                    <span class="inline-block text-xs font-medium text-brand bg-brand-light px-2 py-1 rounded mb-3">{localizeIndustry(c.data.industry, lang)}</span>
                  )}
                  <h3 class="text-xl font-semibold text-brand-dark">{c.data.title}</h3>
                  <p class="mt-2 text-slate-600 text-sm leading-relaxed">{c.data.summary}</p>
                </div>
              </a>
            ))}
          </div>

          <p class="text-slate-500 py-12 text-center hidden" id="caseEmpty">{lang === 'zh' ? '该分类下暂无案例' : lang === 'de' ? 'Keine Projekte in dieser Kategorie' : 'No cases in this category'}</p>
        </div>
      </div>
    )}
  </section>
</BaseLayout>

<script is:inline define:vars={{ defaultCat }}>
  (function () {
    var params = new URLSearchParams(location.search);
    var cat = params.get('cat') || defaultCat;
    var grid = document.getElementById('caseGrid');
    var empty = document.getElementById('caseEmpty');
    var cards = grid ? Array.from(grid.querySelectorAll('.case-card')) : [];
    var btns = Array.from(document.querySelectorAll('.case-cat-btn'));

    function paint(cat) {
      var visible = 0;
      cards.forEach(function (c) {
        var show = c.dataset.industry === cat;
        c.style.display = show ? '' : 'none';
        if (show) visible++;
      });
      if (empty) empty.classList.toggle('hidden', visible !== 0);
      btns.forEach(function (b) {
        var on = b.dataset.cat === cat;
        b.className = 'case-cat-btn w-full text-left px-3 py-2 rounded-lg text-sm font-medium transition ' +
          (on ? 'bg-brand text-white shadow-sm' : 'text-slate-600 hover:bg-slate-100 hover:text-brand');
      });
    }

    btns.forEach(function (b) {
      b.addEventListener('click', function () {
        var c = b.dataset.cat || defaultCat;
        var basePath = location.pathname.replace(/\/+$/, '');
        var url = basePath + '?cat=' + encodeURIComponent(c);
        history.replaceState(null, '', url);
        paint(c);
      });
    });

    paint(cat);
  })();
</script>
