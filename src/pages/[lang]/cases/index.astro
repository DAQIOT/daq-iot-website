---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getTranslations } from '../../../i18n/utils';
import type { Lang } from '../../../i18n/config';
import { getCollection } from 'astro:content';

export function getStaticPaths() {
  return (['en', 'zh', 'de'] as Lang[]).map((lang) => ({ params: { lang } }));
}
const { lang } = Astro.params as { lang: Lang };
const t = await getTranslations(lang);
const base = '/' + lang;

const activeCat = Astro.url.searchParams.get('cat') || 'all';

const all = await getCollection('cases', (entry) => entry.id.startsWith(lang + '/') && !entry.data.hidden);
const cases = all.sort((a, b) => (a.data.order ?? 0) - (b.data.order ?? 0));

// 从案例的 industry 字段动态生成筛选标签
const industryList = [...new Set(cases.map((c) => c.data.industry).filter(Boolean))];
const cats = [
  { key: 'all', label: lang === 'zh' ? '全部案例' : lang === 'de' ? 'Alle Projekte' : 'All Cases' },
  ...industryList.map((ind) => ({ key: ind, label: ind }))
];
---
<BaseLayout lang={lang} title={t('nav.cases') + ' | DAQ-IOT'} description={t('nav.cases')}>
  <section class="bg-brand-dark">
    <div class="mx-auto max-w-7xl px-4 py-14">
      <h1 class="text-3xl md:text-4xl font-bold text-white">{t('nav.cases')}</h1>
      <p class="mt-3 text-slate-300 max-w-2xl">DAQ-IOT {t('nav.cases')} — Industrial IoT data acquisition & monitoring deployment stories across smart manufacturing and new energy.</p>
    </div>
  </section>

  <section class="mx-auto max-w-7xl px-4 py-12">
    {cases.length === 0 ? (
      <p class="text-slate-500 py-12 text-center">暂无案例，欢迎在后台「项目案例」中添加。</p>
    ) : (
      <>
        <!-- 行业筛选标签 -->
        <div class="flex flex-wrap gap-2 mb-10" id="caseCatFilter">
          {cats.map((c) => (
            <button type="button" data-cat={c.key}
              class={`case-cat-btn px-4 py-2 rounded-full text-sm font-medium border transition ${
                (activeCat === c.key || (activeCat === 'all' && c.key === 'all'))
                  ? 'bg-brand text-white border-brand'
                  : 'bg-white text-slate-600 border-slate-200 hover:border-brand hover:text-brand'
              }`}>
              {c.label}
            </button>
          ))}
        </div>

        <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-7" id="caseGrid">
          {cases.map((c) => (
            <a href={'/' + lang + '/cases/' + c.id.split('/').slice(1).join('/')}
               data-industry={c.data.industry || ''}
               class="case-card card-hover block bg-white border border-slate-200 rounded-2xl overflow-hidden">
              {c.data.image && <img src={c.data.image} alt={c.data.title} class="w-full h-48 object-cover bg-slate-50" />}
              <div class="p-6">
                {c.data.industry && (
                  <span class="inline-block text-xs font-medium text-brand bg-brand-light px-2 py-1 rounded mb-3">{c.data.industry}</span>
                )}
                <h3 class="text-xl font-semibold text-brand-dark">{c.data.title}</h3>
                <p class="mt-2 text-slate-600 text-sm leading-relaxed">{c.data.summary}</p>
              </div>
            </a>
          ))}
        </div>

        <p class="text-slate-500 py-12 text-center hidden" id="caseEmpty">{lang === 'zh' ? '该分类下暂无案例' : lang === 'de' ? 'Keine Projekte in dieser Kategorie' : 'No cases in this category'}</p>
      </>
    )}
  </section>
</BaseLayout>

<script is:inline>
  (function () {
    var params = new URLSearchParams(location.search);
    var cat = params.get('cat') || 'all';
    var grid = document.getElementById('caseGrid');
    var empty = document.getElementById('caseEmpty');
    var cards = grid ? Array.from(grid.querySelectorAll('.case-card')) : [];
    var btns = Array.from(document.querySelectorAll('.case-cat-btn'));

    function paint(cat) {
      var visible = 0;
      cards.forEach(function (c) {
        var show = cat === 'all' || c.dataset.industry === cat;
        c.style.display = show ? '' : 'none';
        if (show) visible++;
      });
      if (empty) empty.classList.toggle('hidden', visible !== 0);
      btns.forEach(function (b) {
        var on = b.dataset.cat === cat;
        b.className = 'case-cat-btn px-4 py-2 rounded-full text-sm font-medium border transition ' +
          (on ? 'bg-brand text-white border-brand' : 'bg-white text-slate-600 border-slate-200 hover:border-brand hover:text-brand');
      });
    }

    btns.forEach(function (b) {
      b.addEventListener('click', function () {
        var c = b.dataset.cat || 'all';
        var basePath = location.pathname.replace(/\/+$/, '');
        var url = c === 'all' ? basePath : basePath + '?cat=' + encodeURIComponent(c);
        history.replaceState(null, '', url);
        paint(c);
      });
    });

    paint(cat);
  })();
</script>
