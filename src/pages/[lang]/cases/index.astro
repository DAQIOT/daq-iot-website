---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getTranslations } from '../../../i18n/utils';
import type { Lang } from '../../../i18n/config';
import { getCollection } from 'astro:content';

export function getStaticPaths() {
  return (['en', 'zh', 'de'] as Lang[]).map((lang) => ({ params: { lang } }));
}
const { lang } = Astro.params as { lang: Lang };
const t = await getTranslations(lang);
const base = '/' + lang;

const all = await getCollection('cases', (entry) => entry.id.startsWith(lang + '/') && !entry.data.hidden);
const cases = all.sort((a, b) => (a.data.order ?? 0) - (b.data.order ?? 0));
---
<BaseLayout lang={lang} title={t('nav.cases') + ' | DAQ-IOT'} description={t('nav.cases')}>
  <section class="bg-brand-dark">
    <div class="mx-auto max-w-7xl px-4 py-14">
      <h1 class="text-3xl md:text-4xl font-bold text-white">{t('nav.cases')}</h1>
      <p class="mt-3 text-slate-300 max-w-2xl">DAQ-IOT {t('nav.cases')} — Industrial IoT data acquisition & monitoring deployment stories across smart manufacturing and new energy.</p>
    </div>
  </section>

  <section class="mx-auto max-w-7xl px-4 py-12">
    {cases.length === 0 ? (
      <p class="text-slate-500 py-12 text-center">暂无案例，欢迎在后台「项目案例」中添加。</p>
    ) : (
      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-7">
        {cases.map((c) => (
          <a href={'/' + lang + '/cases/' + c.id.split('/').slice(1).join('/')}
             class="case-card card-hover block bg-white border border-slate-200 rounded-2xl overflow-hidden">
            {c.data.image && <img src={c.data.image} alt={c.data.title} class="w-full h-48 object-cover bg-slate-50" />}
            <div class="p-6">
              {c.data.industry && (
                <span class="inline-block text-xs font-medium text-brand bg-brand-light px-2 py-1 rounded mb-3">{c.data.industry}</span>
              )}
              <h3 class="text-xl font-semibold text-brand-dark">{c.data.title}</h3>
              <p class="mt-2 text-slate-600 text-sm leading-relaxed">{c.data.summary}</p>
            </div>
          </a>
        ))}
      </div>
    )}
  </section>
</BaseLayout>
