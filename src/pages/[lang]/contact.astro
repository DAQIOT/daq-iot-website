---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getTranslations } from '../../i18n/utils';
import type { Lang } from '../../i18n/config';

export function getStaticPaths() {
  return (['en', 'zh', 'de'] as Lang[]).map((lang) => ({ params: { lang } }));
}
const { lang } = Astro.params as { lang: Lang };
const t = await getTranslations(lang);
// 手机号框标签兜底（后台未填时按语言显示）
const phoneFallback = lang === 'zh' ? '手机号' : lang === 'de' ? 'Telefon / WhatsApp' : 'Phone / WhatsApp';

// Web3Forms 收件配置：优先读后台（联系我们 - 表单密钥），留空则回退到这里的默认 key。
// 想换收件邮箱：到 web3forms.com 用新邮箱生成 access key，填到后台对应语言即可，无需改代码。
const FALLBACK_KEY = '93b9c083-e982-4195-ae00-51d9202acaf9';
const FALLBACK_SUBJECT = 'New Inquiry from DAQ-IOT Website';
const formKey = t('contact.formKey', FALLBACK_KEY) || FALLBACK_KEY;
const formSubject = t('contact.formSubject', FALLBACK_SUBJECT) || FALLBACK_SUBJECT;
---
<BaseLayout lang={lang} title={t('contact.title') + ' | DAQ-IOT'} description={t('contact.subtitle')}>
  <!-- layout: max-w-6xl gives long EN/DE addresses room (revised 2026-08-19) -->
  <section class="mx-auto max-w-6xl px-4 py-16">
    <div class="grid gap-10 lg:grid-cols-[1fr_1.15fr] lg:gap-12 items-start">
      <div class="space-y-4 text-slate-700">
        <h1 class="text-4xl font-bold text-slate-900">{t('contact.title')}</h1>
        <p class="text-slate-500">{t('contact.subtitle')}</p>
        <h2 class="text-xl font-semibold text-slate-900 pt-2">{t('contact.infoTitle')}</h2>
        <p><span class="font-medium">{t('contact.person')}:</span> {t('contact.personName')}</p>
        <p><span class="font-medium">{t('contact.email')}:</span> {t('contact.emailValue')}</p>
        <p><span class="font-medium">{t('contact.phone')}:</span> {t('contact.phoneValue')}</p>
        <p><span class="font-medium">{t('contact.mobile')}:</span> {t('contact.mobileValue')}</p>
        <div class="break-words">
          <p class="font-medium mb-2">{t('contact.address')}:</p>
          <ol class="list-decimal pl-5 space-y-2 marker:text-slate-500 marker:font-medium">
            <li class="text-sm text-slate-600">{t('contact.address1')}</li>
            <li class="text-sm text-slate-600">{t('contact.address2')}</li>
            <li class="text-sm text-slate-600">{t('contact.address3')}</li>
            <li class="text-sm text-slate-600">{t('contact.address4')}</li>
            <li class="text-sm text-slate-600">{t('contact.address5')}</li>
          </ol>
        </div>
      </div>

      <!--
        收件配置已改为后台可配（后台 → 联系我们 → 表单密钥 / 邮件标题）。
        中文站可填 business@ 的 key，英/德站填 export@ 的 key，实现分语言收件。
        未填时回退到本文件顶部的 FALLBACK_KEY（原默认 key），行为与之前一致。
        Web3Forms 说明：一个 access_key 绑定一个收件邮箱，key 本身是公开别名、不是密码，可安全放在页面源码里。
      -->
      <form action="https://api.web3forms.com/submit" method="POST" class="space-y-3">
        <input type="hidden" name="access_key" value={formKey} />
        <input type="hidden" name="subject" value={formSubject} />
        <input type="checkbox" name="botcheck" class="hidden" style="display:none" />

        <div>
          <label class="block text-sm font-medium text-slate-700 mb-1">{t('contact.name')}</label>
          <input type="text" name="name" required class="w-full border border-slate-300 rounded-md px-3 py-2 focus:outline-none focus:ring-2 focus:ring-brand" />
        </div>
        <div>
          <label class="block text-sm font-medium text-slate-700 mb-1">{t('contact.email')}</label>
          <input type="email" name="email" required class="w-full border border-slate-300 rounded-md px-3 py-2 focus:outline-none focus:ring-2 focus:ring-brand" />
        </div>
        <!-- 手机号：可选字段，不做格式校验，原样随表单发到收件邮箱 -->
        <div>
          <label class="block text-sm font-medium text-slate-700 mb-1">{t('contact.phoneField', phoneFallback)}</label>
          <input type="tel" name="phone" autocomplete="tel" class="w-full border border-slate-300 rounded-md px-3 py-2 focus:outline-none focus:ring-2 focus:ring-brand" />
        </div>
        <div>
          <label class="block text-sm font-medium text-slate-700 mb-1">{t('contact.company')}</label>
          <input type="text" name="company" class="w-full border border-slate-300 rounded-md px-3 py-2 focus:outline-none focus:ring-2 focus:ring-brand" />
        </div>
        <div>
          <label class="block text-sm font-medium text-slate-700 mb-1">{t('contact.message')}</label>
          <textarea name="message" rows="4" required class="w-full border border-slate-300 rounded-md px-3 py-2 focus:outline-none focus:ring-2 focus:ring-brand resize-none"></textarea>
        </div>
        <button type="submit" class="w-full bg-brand text-white py-3 rounded-md font-medium hover:bg-brand-dark transition">{t('contact.submit')}</button>
      </form>
    </div>
  </section>
</BaseLayout>
