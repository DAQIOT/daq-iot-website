---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionBand from '../../components/SectionBand.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import CategoryIcon from '../../components/CategoryIcon.astro';
import { getTranslations, getSiteData, getCategoriesByLang } from '../../i18n/utils';
import type { Lang } from '../../i18n/config';

export function getStaticPaths() {
  return (['en', 'zh', 'de'] as Lang[]).map((lang) => ({ params: { lang } }));
}
const { lang } = Astro.params as { lang: Lang };
const t = await getTranslations(lang);
const site = await getSiteData(lang);
const base = '/' + lang;

// 首页只展示一级分类（二级分类在产品页和导航下拉中展示）
const categories = (await getCategoriesByLang(lang)).filter((c) => !c.data.parent);

// 分类 slug → 图标名（中英文分类 slug 不同，都映射到同一套图标）
const iconBySlug: Record<string, string> = {
  'daq-meter': 'gauge', 'instrumentation': 'gauge',            // 仪器仪表采集
  'daq-sensor': 'signal', 'wirelesssensor': 'signal',          // 无线传感器
  'daq-camera': 'camera', 'wirelesstimingphotography': 'camera', // 定时抓拍
  'daq-gateway': 'chip', 'plcacquisition': 'chip',             // 采集终端 / PLC
  'daq-software': 'software', 'dataacquisitionsoftware': 'software', // 软件平台
  'daq-install': 'tools'                                       // 安装施工
};

// 分类卡片默认背景图（可在后台「网站基础文案 → 产品矩阵卡片背景图」中按图标覆盖上传）
const defaultCardBg: Record<string, string> = {
  gauge: '/images/categories/instrumentation-bg.jpg',
  signal: '/images/categories/wireless-sensor-bg.jpg',
  camera: '/images/categories/camera-bg.jpg',
  chip: '/images/categories/gateway-bg.jpg',
  software: '/images/categories/software-bg.jpg',
  tools: '/images/categories/install-bg.jpg'
};
const cardBgCfg = (site.categoryCards ?? {}) as Record<string, string>;

const families = categories.map((c) => ({
  slug: c.data.slug,
  name: c.data.name,
  description: c.data.description,
  icon: iconBySlug[c.data.slug] ?? 'chip',
  bg: cardBgCfg[iconBySlug[c.data.slug] ?? 'chip'] || defaultCardBg[iconBySlug[c.data.slug] ?? 'chip'],
  href: base + '/products?cat=' + c.data.slug
}));

// 行业卡片主题背景图（按配置顺序一一对应）
const industryBgs = [
  '/images/industry-manufacturing.jpg',
  '/images/industry-pv.jpg',
  '/images/industry-city.jpg',
  '/images/industry-energy.jpg',
];
const industries = (site.home?.industries ?? []).map((it: { label: string }, i: number) => ({
  n: String(i + 1).padStart(2, '0'),
  label: it.label,
  bg: industryBgs[i] ?? ''
}));

const stats = (site.home?.stats ?? []).map((s: { value: string; label: string }) => ({
  v: s.value,
  l: s.label
}));

// 首页横幅背景图：homeImages 轮播列表优先，其次单图 homeImage（后台「网站基础文案 → 页面横幅背景图」配置）
// homeImages 兼容两种结构：纯字符串数组（手写 YAML）或 [{image: 路径}]（CMS list widget）
const heroRaw = (site.banner?.homeImages as unknown) ?? [];
const heroImagesList = (Array.isArray(heroRaw) ? heroRaw : [])
  .map((it: unknown) => (typeof it === 'string' ? it : (it as { image?: string })?.image))
  .filter((s): s is string => Boolean(s));
const heroImage = (site.banner?.homeImage as string) || '';
const heroImages = heroImagesList.length ? heroImagesList : (heroImage ? [heroImage] : []);
const hasHeroImg = heroImages.length > 0;
// 首页底部横条背景图（同上，留空则用默认渐变纹理）
const partnersImage = (site.banner?.partnersImage as string) || '';
const ctaImage = (site.banner?.ctaImage as string) || '';

// 合作伙伴滚动墙：行业客户 + 系统集成商的后台 Logo 合并（保持后台顺序，客户在前）
const partnerLogos = [
  ...(((site.customers as Record<string, any>)?.sections ?? []) as any[]),
  ...(((site.integrators as Record<string, any>)?.sections ?? []) as any[]),
]
  .flatMap((s) => (Array.isArray(s?.logos) ? s.logos : []))
  .map((l) => ({ name: String(l?.name ?? '').trim(), image: String(l?.image ?? '').trim() }))
  .filter((l) => l.image);

// 区块小标签（eyebrow）：后台未配置时使用内置文案，配置后自动覆盖
const EYEBROW = {
  zh: { products: 'PRODUCTS', solutions: 'SOLUTIONS', stats: 'MILESTONES' },
  en: { products: 'PRODUCTS', solutions: 'SOLUTIONS', stats: 'MILESTONES' },
  de: { products: 'PRODUKTE', solutions: 'LÖSUNGEN', stats: 'MEILENSTEINE' },
}[lang];
---
<BaseLayout lang={lang} title={t('hero.title') + ' | DAQ-IOT'} description={t('hero.subtitle')}>

  <!-- Hero -->
  <section class="relative isolate overflow-hidden bg-brand-dark">
    {heroImages.map((src, i) => (
      <img
        src={src}
        alt=""
        aria-hidden="true"
        class:list={['hero-slide pointer-events-none absolute inset-0 h-full w-full object-cover', i === 0 && 'is-active']}
        loading={i === 0 ? 'eager' : 'lazy'}
        fetchpriority={i === 0 ? 'high' : undefined}
      />
    ))}
    <!-- 轮播图直接展示原图，不加任何遮罩 -->
    <!-- 无背景图时才加光晕/网格/压暗遮罩 -->
    {!hasHeroImg && (
      <div class="absolute inset-0 bg-[radial-gradient(circle_at_20%_20%,rgba(37,99,235,0.25),transparent_55%),radial-gradient(circle_at_80%_60%,rgba(14,165,233,0.18),transparent_50%)]"></div>
    )}
    {!hasHeroImg && (
      <div class="absolute inset-0 opacity-[0.07]" style="background-image:url('data:image/svg+xml;utf8,<svg xmlns=\'http://www.w3.org/2000/svg\' width=\'40\' height=\'40\'><path d=\'M0 39.5H40M39.5 0V40\' fill=\'none\' stroke=\'white\' stroke-width=\'1\'/></svg>')"></div>
    )}
    {!hasHeroImg && (
      <div class="absolute inset-0 bg-gradient-to-r from-brand-darker via-brand-darker/85 to-transparent"></div>
    )}
    <div class="relative mx-auto max-w-[1600px] px-4 lg:px-8 py-24 md:py-32">
      <div data-reveal="fade" class="inline-block">
        <p class="text-brand text-xl md:text-2xl lg:text-3xl font-black tracking-[0.15em] uppercase drop-shadow-[0_2px_10px_rgba(2,20,40,0.9)]">{t('home.eyebrow')}</p>
        <div class="mt-3 h-0.5 w-full bg-brand/80 rounded-full"></div>
      </div>
      <h1 data-reveal style="--rd:80ms" class="mt-5 text-xl md:text-3xl font-bold text-white whitespace-nowrap leading-tight drop-shadow-[0_2px_12px_rgba(2,20,40,0.95)]">{t('home.heroTitle')}</h1>
      <p data-reveal style="--rd:160ms" class="mt-6 text-lg text-slate-100 max-w-2xl drop-shadow-[0_2px_10px_rgba(2,20,40,0.95)]">{t('home.heroSubtitle')}</p>
      <div data-reveal style="--rd:240ms" class="mt-8 flex flex-wrap gap-4">
        <a href={base + '/contact'} class="btn btn-primary">{t('home.heroCta1')}</a>
        <a href={base + '/products'} class="btn btn-outline">{t('home.heroCta2')}</a>
      </div>
    </div>
  </section>

  <!-- 五大产品矩阵 -->
  <section class="relative">
    <div class="relative mx-auto max-w-[1600px] px-4 lg:px-8 py-20">
      <SectionHeading
        eyebrow={t('home.categoriesEyebrow', EYEBROW.products)}
        title={t('home.categoriesTitle')}
        subtitle={t('home.categoriesSubtitle')}
        href={base + '/products'}
        linkText={t('home.viewAll')}
      />
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-5">
        {families.map((f, i) => (
          <a
            href={f.href}
            data-reveal
            style={`--rd:${i * 80}ms`}
            class="card-hover group relative block overflow-hidden bg-white border border-slate-200 rounded-2xl p-6 hover:border-brand"
          >
            <img
              src={f.bg}
              alt=""
              aria-hidden="true"
              class="card-media pointer-events-none absolute inset-0 h-full w-full object-cover transition duration-700 ease-out"
              loading="lazy"
            />
            <div class="relative">
              <div class="flex items-center gap-3 mb-4">
                <div class="w-12 h-12 rounded-xl bg-white/85 backdrop-blur-sm flex items-center justify-center shrink-0 group-hover:bg-brand group-hover:text-white text-brand transition">
                  <CategoryIcon name={f.icon} class="w-6 h-6" />
                </div>
                <h3 class="text-lg font-semibold text-brand-dark group-hover:text-brand transition">{f.name}</h3>
              </div>
              <p class="text-sm text-slate-500 leading-relaxed">{f.description}</p>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- 行业解决方案 -->
  <section class="relative border-y border-slate-100">
    <div class="relative mx-auto max-w-[1600px] px-4 lg:px-8 py-20">
      <SectionHeading
        eyebrow={t('home.solutionsEyebrow', EYEBROW.solutions)}
        title={t('home.solutionsTitle')}
        subtitle={t('home.solutionsSubtitle')}
        href={base + '/solutions'}
        linkText={t('nav.solutions')}
      />
      <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-6">
        {industries.map((it, i) => (
          <a
            href={base + '/solutions'}
            data-reveal
            style={`--rd:${i * 90}ms`}
            class="card-hover group relative block overflow-hidden rounded-2xl border border-slate-200 bg-white p-7 hover:border-brand"
          >
            {it.bg && (
              <img
                src={it.bg}
                alt=""
                aria-hidden="true"
                class="card-media pointer-events-none absolute inset-0 h-full w-full object-cover"
                loading="lazy"
              />
            )}
            <div class="pointer-events-none absolute inset-0 bg-gradient-to-t from-white via-white/60 to-transparent"></div>
            <div class="relative">
              <span class="inline-block text-brand/40 text-3xl font-black tabular-nums transition group-hover:text-brand">{it.n}</span>
              <h3 class="mt-3 text-xl font-semibold text-brand-dark transition group-hover:text-brand">{it.label}</h3>
              <span class="absolute left-0 -bottom-1 h-0.5 w-8 bg-brand transition-all duration-300 group-hover:w-14"></span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- 数据基石 -->
  <section class="relative bg-slate-50 border-y border-slate-100">
    <div class="relative mx-auto max-w-[1600px] px-4 lg:px-8 py-20">
      <SectionHeading
        eyebrow={t('home.statsEyebrow', EYEBROW.stats)}
        title={t('home.statsTitle')}
      />
      <div class="grid grid-cols-2 lg:grid-cols-4 gap-8">
        {stats.map((s, i) => (
          <div data-reveal style={`--rd:${i * 90}ms`} class="group text-center">
            <div
              data-count={s.v}
              class="text-4xl md:text-5xl font-bold text-brand tabular-nums transition-transform duration-300 group-hover:scale-105"
            >
              {s.v}
            </div>
            <div class="mx-auto mt-3 h-px w-10 bg-brand/30 transition-all duration-300 group-hover:w-16 group-hover:bg-brand"></div>
            <div class="mt-3 text-slate-500 text-sm">{s.l}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 合作伙伴 -->
  <SectionBand tone="dark" width="wide" image={partnersImage} overlay={0.5}>
    <h2 data-reveal="fade" class="text-2xl md:text-3xl font-bold text-white">{t('home.partnersTitle')}</h2>
    <p data-reveal="fade" style="--rd:80ms" class="mt-3 text-slate-400">{t('home.partnersSubtitle')}</p>

    {partnerLogos.length > 0 && (
      <div data-reveal="fade" style="--rd:160ms" class="logo-marquee mt-8" data-marquee>
        <div class="logo-marquee-track">
          {/* 无缝循环：同一份列表渲染两遍，动画位移 -50% 后重接 */}
          {[0, 1].map((copy) => (
            <div class="logo-marquee-group" aria-hidden={copy === 1 ? 'true' : undefined}>
              {partnerLogos.map((l) => (
                <div class="logo-marquee-item" title={l.name}>
                  {/* 直接用后台原图（保留品牌彩色）。logo 放在白色卡片衬底上：
                      彩色/黑白 logo 都清晰，部分白底未抠净的素材也与卡片融为一体。
                      轨道靠 transform 持续移动，浏览器懒加载永不触发，必须 eager */}
                  <img
                    src={l.image}
                    alt={copy === 1 ? '' : l.name}
                    loading="eager"
                    decoding="async"
                  />
                </div>
              ))}
            </div>
          ))}
        </div>
      </div>
    )}

    <div data-reveal="fade" style="--rd:240ms" class="mt-8">
      <a href={base + '/partners'} class="btn btn-outline">{t('nav.partners')}</a>
    </div>
  </SectionBand>

  <!-- CTA（浅色：避免与上方合作伙伴连成两块深色；有背景图时文字自动转白保证可读） -->
  <SectionBand tone="light" width="wide" image={ctaImage}>
    <h2
      data-reveal="fade"
      class:list={['text-2xl md:text-3xl lg:text-4xl font-bold', ctaImage ? 'text-white drop-shadow-[0_2px_10px_rgba(2,20,40,0.85)]' : 'text-brand-dark']}
    >
      {t('home.ctaTitle')}
    </h2>
    <p
      data-reveal="fade"
      style="--rd:80ms"
      class:list={['mt-4 max-w-2xl mx-auto leading-relaxed', ctaImage ? 'text-white/85 drop-shadow-[0_2px_10px_rgba(2,20,40,0.85)]' : 'text-slate-500']}
    >
      {t('home.ctaSubtitle')}
    </p>
    <div data-reveal="fade" style="--rd:160ms" class="mt-8">
      <a href={base + '/contact'} class="btn btn-primary">{t('home.ctaButton')}</a>
    </div>
  </SectionBand>
</BaseLayout>

<style>
  /* Hero 轮播：多张背景图淡入淡出切换 */
  .hero-slide {
    opacity: 0;
    transition: opacity 1.2s ease;
  }
  .hero-slide.is-active {
    opacity: 1;
  }
  @media (prefers-reduced-motion: reduce) {
    .hero-slide {
      transition: none;
    }
  }

  /* ── 合作伙伴 Logo 滚动墙（白色卡片式）──
     背景：后台上传的 logo 素材混杂 —— 一部分白底没抠净、一部分是黑色为主的内容，
     任何「统一反白」或「透明直排」方案都无法同时兼顾。
     现行方案：彩色原图 + 白色圆角卡片衬底 ——
       · 彩色 / 黑白 logo 在白卡片上都清晰；
       · 白底未抠净的素材与卡片融为一体，看不出方块；
       · 在任何背景图（亮图/暗图）上都成立，不再依赖 partners-alpha 预处理。
     （scripts/gen-logo-alpha.mjs 生成的透明底版本保留在 /images/partners-alpha/，
      当前首页已不使用；如需恢复透明直排方案可再启用。） */
  .logo-marquee {
    overflow: hidden;
    padding: 0.875rem 0;
    /* 两端渐隐，暗示内容在继续滚动 */
    mask-image: linear-gradient(90deg, transparent, #000 5%, #000 95%, transparent);
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 5%, #000 95%, transparent);
  }
  .logo-marquee-track {
    display: flex;
    width: max-content;
    /* 兜底值：JS 会按轨道宽度换算成长时覆盖它；这里取慢值，避免脚本未执行时飞快闪过 */
    animation: logo-marquee 180s linear infinite;
  }
  .logo-marquee:hover .logo-marquee-track {
    animation-play-state: paused;
  }
  .logo-marquee-group {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    padding-right: 1.25rem;
  }
  .logo-marquee-item {
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    height: 4.25rem;
    padding: 0 1.125rem;
    /* 白色卡片衬底：承载彩色 logo，并与白底素材融为一体 */
    background: #fff;
    border-radius: 0.75rem;
    box-shadow: 0 2px 10px rgba(2, 20, 40, 0.22);
    transition: transform 0.25s ease;
  }
  .logo-marquee-item:hover {
    transform: translateY(-3px);
  }
  .logo-marquee-item img {
    max-height: 3rem;
    max-width: 8.5rem;
    width: auto;
    object-fit: contain;
    /* 保留品牌原色，不再反白 */
    opacity: 0.92;
    transition: opacity 0.25s ease;
  }
  .logo-marquee-item:hover img {
    opacity: 1;
  }
  @keyframes logo-marquee {
    from {
      transform: translateX(0);
    }
    to {
      /* 位移一个列表的宽度（两组中的一组），实现无缝循环 */
      transform: translateX(-50%);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .logo-marquee {
      mask-image: none;
      -webkit-mask-image: none;
      overflow-x: auto;
    }
    .logo-marquee-track {
      animation: none;
    }
  }
</style>

<script>
  const slides = document.querySelectorAll('.hero-slide');
  if (slides.length > 1) {
    let idx = 0;
    setInterval(() => {
      slides[idx].classList.remove('is-active');
      idx = (idx + 1) % slides.length;
      slides[idx].classList.add('is-active');
    }, 5000);
  }

  // Logo 滚动墙：按轨道宽度动态计算时长，保证恒定速度，logo 多少都不影响快慢
  // 想再慢/再快：调 SPEED（px/s，越小越慢；建议 20~45）
  const SPEED = 30;
  const track = document.querySelector('.logo-marquee-track');
  if (track) {
    const half = track.scrollWidth / 2; // 一组列表的宽度
    if (half > 0) track.style.animationDuration = Math.max(45, Math.round(half / SPEED)) + 's';
  }
</script>
