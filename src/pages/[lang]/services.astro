---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getTranslations, getSiteData, getAllCases, getPageTags } from '../../i18n/utils';
import type { Lang } from '../../i18n/config';
import PageHero from '../../components/PageHero.astro';
import PageTagCards from '../../components/PageTagCards.astro';

export function getStaticPaths() {
  return (['en', 'zh', 'de'] as Lang[]).map((lang) => ({ params: { lang } }));
}
const { lang } = Astro.params as { lang: Lang };
const t = await getTranslations(lang);
const site = await getSiteData(lang);
const base = '/' + lang;

// 页面横幅背景图（后台「网站基础文案 → 页面横幅背景图」配置，留空用默认渐变纹理）
const bannerImage = ((site.banner?.servicesImage as string) || (site.banner?.pageImage as string) || '');

// 服务列表 = 标签（点卡片展开该分类下的案例）
const tags = await getPageTags(lang, 'services');
// 服务项目小标题（后台可改，留空按语言兜底）
const itemsTitle =
  (site.services?.itemsTitle as string) ||
  (lang === 'zh' ? '服务项目' : lang === 'de' ? 'Unsere Leistungen' : 'Our Services');

// 技术支持板块：后台「页面文案 → 服务与支持」里的「技术支持 · …」字段维护
// （原独立 support 集合已并入本页面，这里保留 site.support 作数据兜底）
const svc = (site.services ?? {}) as Record<string, any>;
const legacySupport = (site.support ?? {}) as Record<string, any>;
const supportItems = ((svc.supportItems ?? legacySupport.items) ?? []) as { title: string; desc: string }[];
const supportTitle =
  (svc.supportTitle as string) ||
  (legacySupport.title as string) ||
  (lang === 'zh' ? '技术支持' : lang === 'de' ? 'Technischer Support' : 'Technical Support');
const supportSubtitle = ((svc.supportSubtitle as string) || (legacySupport.subtitle as string) || '');

// 案例池 = 全部案例；归到哪张卡片由案例的「归属标签」决定（如「服务与支持 · 定制开发」）
const cases = await getAllCases(lang);
---
<BaseLayout lang={lang} title={t('services.title') + ' | DAQ-IOT'} description={t('services.subtitle')}>
  <PageHero title={t('services.title')} subtitle={t('services.subtitle')} image={bannerImage} />

  <!-- 服务项目 -->
  <section class="mx-auto max-w-[1600px] px-4 lg:px-8 py-16">
    <div class="text-center mb-12">
      <h2 class="text-3xl font-bold text-brand-dark">{itemsTitle}</h2>
    </div>
    <!-- 服务卡片 = 标签：点卡片展开该分类下的案例 -->
    <PageTagCards lang={lang} page="services" tags={tags} cases={cases} variant="md" />
  </section>

  <!-- 技术支持（原「支持」页面内容已合并到这里） -->
  {supportItems.length > 0 && (
    <section id="support" class="bg-slate-50 border-y border-slate-100 scroll-mt-20">
      <div class="mx-auto max-w-[1600px] px-4 lg:px-8 py-16">
        <div class="text-center mb-12">
          <h2 class="text-3xl font-bold text-brand-dark">{supportTitle}</h2>
          {supportSubtitle && <p class="mt-3 text-slate-500 max-w-3xl mx-auto">{supportSubtitle}</p>}
        </div>
        <div class="grid sm:grid-cols-3 gap-6">
          {supportItems.map((it) => (
            <div class="bg-white border border-slate-200 rounded-2xl p-8 card-hover">
              <h3 class="text-lg font-semibold text-brand-dark">{it.title}</h3>
              <p class="mt-2 text-slate-600 text-sm leading-relaxed">{it.desc}</p>
            </div>
          ))}
        </div>
      </div>
    </section>
  )}

  <section class="mx-auto max-w-[1600px] px-4 lg:px-8 pb-16">
    <div class="text-center">
      <a href={base + '/contact'} class="inline-block bg-brand text-white px-7 py-3 rounded-md font-medium hover:bg-brand-dark transition">{t('nav.cta')}</a>
    </div>
  </section>
</BaseLayout>
