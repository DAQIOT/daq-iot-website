---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getTranslations, getSiteData } from '../../i18n/utils';
import type { Lang } from '../../i18n/config';
import PageHero from '../../components/PageHero.astro';

export function getStaticPaths() {
  return (['en', 'zh', 'de'] as Lang[]).map((lang) => ({ params: { lang } }));
}
const { lang } = Astro.params as { lang: Lang };
const t = await getTranslations(lang);
const site = await getSiteData(lang);
const base = '/' + lang;

// 页面横幅背景图（后台「网站基础文案 → 页面横幅背景图」配置，留空用默认渐变纹理）
const bannerImage = (site.banner?.pageImage as string) || '';

const items = (site.services?.items ?? []).map((it: { title: string; desc: string }, i: number) => ({
  n: String(i + 1).padStart(2, '0'),
  title: it.title,
  desc: it.desc
}));
---
<BaseLayout lang={lang} title={t('services.title') + ' | DAQ-IOT'} description={t('services.subtitle')}>
  <PageHero title={t('services.title')} subtitle={t('services.subtitle')} image={bannerImage} />

  <section class="mx-auto max-w-7xl px-4 py-16">
    <div class="grid sm:grid-cols-2 gap-6">
      {items.map((it) => (
        <div class="bg-white border border-slate-200 rounded-2xl p-8 card-hover">
          <span class="text-brand/30 text-4xl font-bold">{it.n}</span>
          <h3 class="mt-3 text-xl font-semibold text-brand-dark">{it.title}</h3>
          <p class="mt-2 text-slate-600 text-sm leading-relaxed">{it.desc}</p>
        </div>
      ))}
    </div>
    <div class="text-center mt-12">
      <a href={base + '/contact'} class="inline-block bg-brand text-white px-7 py-3 rounded-md font-medium hover:bg-brand-dark transition">{t('nav.cta')}</a>
    </div>
  </section>
</BaseLayout>
