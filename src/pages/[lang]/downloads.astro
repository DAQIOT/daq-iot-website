---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getTranslations } from '../../i18n/utils';
import type { Lang } from '../../i18n/config';
import { getCollection } from 'astro:content';
import { renderMarkdown } from '../../lib/renderMarkdown';

export function getStaticPaths() {
  return (['en', 'zh', 'de'] as Lang[]).map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params as { lang: Lang };
const t = await getTranslations(lang);
const base = '/' + lang;

const activeCat = Astro.url.searchParams.get('cat') || 'all';

const items = (await getCollection('downloads', (e) => e.id.startsWith(lang + '/')))
  .sort((a, b) => (a.data.order ?? 0) - (b.data.order ?? 0));
const enriched = await Promise.all(
  items.map(async (d) => ({
    ...d,
    changelogHtml: d.data.changelog ? await renderMarkdown(d.data.changelog) : '',
  }))
);

const iconLabels: Record<string, string> = {
  windows: 'Windows',
  macos: 'macOS',
  linux: 'Linux',
  all: lang === 'zh' ? '全平台' : lang === 'de' ? 'Alle Plattformen' : 'All platforms',
};
const fileTypeColor: Record<string, string> = {
  ZIP: 'bg-blue-100 text-blue-600',
  EXE: 'bg-emerald-100 text-emerald-600',
  APK: 'bg-purple-100 text-purple-600',
  PDF: 'bg-rose-100 text-rose-600',
  MSI: 'bg-amber-100 text-amber-600',
  RAR: 'bg-slate-100 text-slate-600',
  DOC: 'bg-indigo-100 text-indigo-600',
};

const dlCats = [
  { key: 'all', label: t('downloads.all') },
  { key: 'software', label: t('downloads.catSoftware') },
  { key: 'config-tool', label: t('downloads.catConfigTool') },
  { key: 'driver', label: t('downloads.catDriver') },
  { key: 'doc', label: t('downloads.catDoc') },
];
---
<BaseLayout lang={lang} title={t('downloads.title') + ' | DAQ-IOT'} description={t('downloads.subtitle')}>
  <section class="bg-brand-dark">
    <div class="mx-auto max-w-7xl px-4 py-14">
      <h1 class="text-3xl md:text-4xl font-bold text-white">{t('downloads.title')}</h1>
      <p class="mt-3 text-slate-300 max-w-2xl">{t('downloads.subtitle')}</p>
    </div>
  </section>

  <section class="mx-auto max-w-7xl px-4 py-10">
    <!-- 分类筛选 -->
    <div class="flex flex-wrap gap-2 mb-10" id="dlCatFilter">
      {dlCats.map((c) => (
        <button type="button" data-cat={c.key}
          class={`dl-cat-btn px-4 py-2 rounded-full text-sm font-medium border transition ${
            (activeCat === c.key || (activeCat === 'all' && c.key === 'all'))
              ? 'bg-brand text-white border-brand'
              : 'bg-white text-slate-600 border-slate-200 hover:border-brand hover:text-brand'
          }`}>
          {c.label}
        </button>
      ))}
    </div>

    <div class="grid md:grid-cols-2 gap-7" id="dlGrid">
      {enriched.map((d) => (
        <div class="bg-white border border-slate-200 rounded-2xl p-6 flex flex-col"
             data-category={d.data.category || ''}>
          <div class="mb-3">
            <span class="inline-block text-xs font-medium text-brand bg-brand-light px-2.5 py-1 rounded mb-3">{iconLabels[d.data.icon ?? 'all'] ?? d.data.icon}</span>
            <h3 class="text-xl font-semibold text-brand-dark leading-tight">{d.data.title}</h3>
            <p class="mt-2 text-slate-600 text-sm leading-relaxed">{d.data.description}</p>
            {d.data.image && (
              <img src={d.data.image} alt={d.data.title} class="mt-3 w-full rounded-lg border border-slate-100" />
            )}
          </div>

          <div class="mt-3 flex flex-wrap items-center gap-x-4 gap-y-1 text-xs text-slate-500">
            {d.data.version && <span>{t('downloads.version')} {d.data.version}</span>}
            {d.data.fileSize && <span>{d.data.fileSize}</span>}
            {d.data.fileType && (
              <span class={`px-2 py-0.5 rounded ${fileTypeColor[d.data.fileType] ?? 'bg-slate-100 text-slate-600'}`}>{d.data.fileType}</span>
            )}
            {d.data.releaseDate && <span>{t('downloads.updated')} {d.data.releaseDate}</span>}
          </div>

          <div class="mt-5 flex flex-wrap gap-3">
            {d.data.file && (
              <a href={d.data.file} download class="inline-flex items-center gap-2 bg-brand text-white px-6 py-2.5 rounded-md font-medium hover:bg-brand-dark transition">
                <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none"><path d="M12 3v12m0 0 4-4m-4 4-4-4M4 21h16" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
                {t('downloads.download')}
              </a>
            )}
            {d.data.links && d.data.links.length > 0 && d.data.links.map((link) => (
              <a
                href={link.url}
                download={link.type === 'local'}
                target={link.type === 'external' ? '_blank' : undefined}
                rel={link.type === 'external' ? 'noopener noreferrer' : undefined}
                class={`inline-flex items-center gap-2 px-5 py-2.5 rounded-md font-medium transition ${link.type === 'external' ? 'border border-brand text-brand hover:bg-brand-light' : 'bg-brand text-white hover:bg-brand-dark'}`}
              >
                <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none"><path d="M12 3v12m0 0 4-4m-4 4-4-4M4 21h16" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
                {link.label}
                {link.type === 'external' && (
                  <svg class="w-3 h-3 ml-1" viewBox="0 0 24 24" fill="none"><path d="M7 17 17 7M17 7H7m10 0v10" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
                )}
              </a>
            ))}
          </div>

          {d.changelogHtml && (
            <div class="mt-5 pt-4 border-t border-slate-100">
              <div class="text-xs font-semibold text-slate-400 uppercase tracking-wide mb-2">{t('downloads.changelog')}</div>
              <div class="text-sm text-slate-600 leading-relaxed prose max-w-none" set:html={d.changelogHtml} />
            </div>
          )}
        </div>
      ))}
    </div>

    {enriched.length === 0 && (
      <p class="text-slate-500 py-12 text-center">{t('downloads.empty')}</p>
    )}
    <p class="text-slate-500 py-12 text-center hidden" id="dlEmpty">{t('downloads.empty')}</p>
  </section>
</BaseLayout>

<script is:inline>
  (function () {
    const params = new URLSearchParams(location.search);
    const cat = params.get('cat') || 'all';
    const grid = document.getElementById('dlGrid');
    const empty = document.getElementById('dlEmpty');
    const btns = document.querySelectorAll('.dl-cat-btn');
    const cards = grid ? Array.from(grid.querySelectorAll('[data-category]')) : [];

    function paint(cat) {
      let visible = 0;
      cards.forEach(function (c) {
        var el = c;
        var show = cat === 'all' || el.dataset.category === cat;
        el.style.display = show ? '' : 'none';
        if (show) visible++;
      });
      if (empty) empty.classList.toggle('hidden', visible !== 0);
      btns.forEach(function (b) {
        var el = b;
        var on = el.dataset.cat === cat;
        b.className = 'dl-cat-btn px-4 py-2 rounded-full text-sm font-medium border transition ' +
          (on ? 'bg-brand text-white border-brand' : 'bg-white text-slate-600 border-slate-200 hover:border-brand hover:text-brand');
      });
    }

    btns.forEach(function (b) {
      b.addEventListener('click', function () {
        var c = b.dataset.cat;
        var url = new URL(location.href);
        if (c === 'all') url.searchParams.delete('cat');
        else url.searchParams.set('cat', c);
        history.replaceState(null, '', url);
        paint(c);
      });
    });

    paint(cat);
  })();
</script>
