---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getTranslations, getCategoriesByLang, getSiteData } from '../../../i18n/utils';
import type { Lang } from '../../../i18n/config';
import { getCollection, render } from 'astro:content';
import { renderMarkdown } from '../../../lib/renderMarkdown';
import PageHero from '../../../components/PageHero.astro';

export async function getStaticPaths() {
  const products = await getCollection('products', (entry) => !entry.data.hidden);
  return products.map((entry) => {
    const [lang, ...slugParts] = entry.id.split('/');
    const slug = slugParts.join('/');
    return {
      params: { lang, slug },
      props: { entry },
    };
  });
}

const { lang, slug } = Astro.params as { lang: Lang; slug: string };
const { entry } = Astro.props;
const t = await getTranslations(lang);
const { Content } = await render(entry);
const paramsHtml = entry.data.parameters ? await renderMarkdown(entry.data.parameters) : '';
const productsHref = '/' + lang + '/products';
const contactHref = '/' + lang + '/contact';
const catName = Object.fromEntries((await getCategoriesByLang(lang)).map((c) => [c.data.slug, c.data.name]));
const site = await getSiteData(lang);
const bannerImage = (site.banner?.pageImage as string) || '';
---
<BaseLayout lang={lang} title={entry.data.title + ' | DAQ-IOT'} description={entry.data.summary}>
  <PageHero title={entry.data.title} image={bannerImage} size="sm" width="narrow">
    <nav slot="breadcrumb" class="text-sm text-slate-400 mb-3">
      <a href={productsHref} class="hover:text-brand">{t('nav.products')}</a>
      <span class="mx-2">/</span>
      <span class="text-slate-200">{catName[entry.data.category] ?? entry.data.category}</span>
    </nav>
  </PageHero>

  <section class="mx-auto max-w-6xl px-4 py-12">
    <div class:list={['grid gap-10 items-start', entry.data.image ? 'md:grid-cols-2' : '']}>
      {entry.data.image && (
        <img src={entry.data.image} alt={entry.data.title} class="w-full h-80 object-contain bg-slate-50 rounded-2xl border border-slate-100 p-4" />
      )}
      <div class="prose prose-slate max-w-none">
        <span class="inline-block text-xs font-medium text-brand bg-brand-light px-2.5 py-1 rounded">{catName[entry.data.category] ?? entry.data.category}</span>
        <p class="mt-4 text-lg text-slate-600 leading-relaxed">{entry.data.summary}</p>
        <a href={contactHref} class="mt-6 inline-block bg-brand text-white px-7 py-3 rounded-md font-medium hover:bg-brand-dark transition">{t('nav.cta', '获取报价')}</a>
      </div>
    </div>

    {paramsHtml && (
      <div class="mt-12">
        <h2 class="text-xl font-bold text-slate-800 mb-4">{t('products.parameters', '产品参数')}</h2>
        <div class="prose max-w-none text-slate-700 leading-relaxed space-y-4" set:html={paramsHtml} />
      </div>
    )}

    <div class="mt-12 border-t border-slate-200 pt-8 text-slate-700 leading-relaxed space-y-4 prose max-w-none">
      <Content />
    </div>
  </section>
</BaseLayout>
