---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getTranslations, getCategoriesByLang, getSiteData } from '../../i18n/utils';
import type { Lang } from '../../i18n/config';
import { getCollection } from 'astro:content';
import PageHero from '../../components/PageHero.astro';

export function getStaticPaths() {
  return (['en', 'zh', 'de'] as Lang[]).map((lang) => ({ params: { lang } }));
}
const { lang } = Astro.params as { lang: Lang };
const t = await getTranslations(lang);
const site = await getSiteData(lang);
const base = '/' + lang;

// 页面横幅背景图（后台「网站基础文案 → 页面横幅背景图」配置，留空用默认渐变纹理）
const bannerImage = (site.banner?.pageImage as string) || '';

// 初始分类：构建时静态页默认选中第一个一级分类，运行时由前端脚本根据 ?cat= 过滤
const activeCatRaw = Astro.url.searchParams.get('cat');

const all = await getCollection('products', (entry) => entry.id.startsWith(lang + '/') && !entry.data.hidden);
const products = all.sort((a, b) => (a.data.order ?? 0) - (b.data.order ?? 0));

const categories = await getCategoriesByLang(lang);
const catName = Object.fromEntries(categories.map((c) => [c.data.slug, c.data.name]));
// 分类：一级 + 二级（无「全部」，默认选中第一个一级分类，竖排展示在左侧）
const parentOf = Object.fromEntries(categories.map((c) => [c.data.slug, c.data.parent || '']));
const topLevel = categories.filter((c) => !c.data.parent);
const cats = [
  ...topLevel.map((c) => ({ key: c.data.slug, label: c.data.name, level: 0 })),
  ...categories.filter((c) => c.data.parent).map((c) => ({ key: c.data.slug, label: c.data.name, level: 1 }))
];
const defaultCat = topLevel[0]?.data.slug ?? cats[0]?.key ?? '';
const activeCat = activeCatRaw || defaultCat;
---
<BaseLayout lang={lang} title={t('products.title') + ' | DAQ-IOT'} description={t('products.subtitle')}>
  <PageHero title={t('products.title')} subtitle={t('products.subtitle')} image={bannerImage} />

  <section class="mx-auto max-w-7xl px-4 py-10">
    <div class="flex flex-col md:flex-row gap-8 items-start">
      <!-- 分类侧栏（竖排；一级分类含其下所有二级产品） -->
      <aside class="w-full md:w-56 md:shrink-0 md:sticky md:top-24">
        <div class="flex flex-wrap md:flex-col gap-2" id="catFilter">
          {cats.map((c) => (
            <button type="button" data-cat={c.key}
              class={`cat-btn w-full text-left px-4 py-2.5 rounded-lg text-sm font-medium border transition ${
                c.level === 1 ? 'md:ml-4 md:text-xs text-xs' : ''
              } ${
                activeCat === c.key
                  ? 'bg-brand text-white border-brand'
                  : 'bg-white text-slate-600 border-slate-200 hover:border-brand hover:text-brand'
              }`}>
              {c.level === 1 ? '· ' : ''}{c.label}
            </button>
          ))}
        </div>
      </aside>

      <!-- 产品网格 -->
      <div class="flex-1 min-w-0">
        <div class="grid md:grid-cols-2 xl:grid-cols-3 gap-7" id="productGrid">
      {products.map((p) => (
        <a href={'/' + lang + '/products/' + p.id.split('/').slice(1).join('/')}
           data-category={p.data.category}
           data-parent-category={parentOf[p.data.category] ?? ''}
           class="product-card card-hover block bg-white border border-slate-200 rounded-2xl overflow-hidden">
          {p.data.image && <img src={p.data.image} alt={p.data.title} class="w-full h-48 object-contain bg-slate-50" />}
          <div class="p-6">
            <span class="inline-block text-xs font-medium text-brand bg-brand-light px-2 py-1 rounded mb-3">{catName[p.data.category] ?? p.data.category}</span>
            <h3 class="text-xl font-semibold text-brand-dark">{p.data.title}</h3>
            <p class="mt-2 text-slate-600 text-sm leading-relaxed">{p.data.summary}</p>
          </div>
        </a>
      ))}
        </div>

        <p class="text-slate-500 py-12 text-center hidden" id="productEmpty">{t('products.empty')}</p>
      </div>
    </div>
  </section>
</BaseLayout>

<script define:vars={{ parentOfMap: parentOf, defaultCat }}>
  const grid = document.getElementById('productGrid');
  const empty = document.getElementById('productEmpty');
  const cards = grid ? Array.from(grid.querySelectorAll('.product-card')) : [];
  const btns = Array.from(document.querySelectorAll('.cat-btn'));

  function paint(cat) {
    let visible = 0;
    cards.forEach((c) => {
      const show = c.dataset.category === cat || c.dataset.parentCategory === cat;
      c.style.display = show ? '' : 'none';
      if (show) visible++;
    });
    if (empty) empty.classList.toggle('hidden', visible !== 0);
    btns.forEach((b) => {
      const on = b.dataset.cat === cat;
      const isChild = b.dataset.cat && parentOfMap[b.dataset.cat] !== undefined;
      const parentActive = isChild && parentOfMap[b.dataset.cat] === cat;
      b.className = 'cat-btn w-full text-left px-4 py-2.5 rounded-lg text-sm font-medium border transition ' +
        (isChild ? 'md:ml-4 text-xs ' : '') +
        (on
          ? 'bg-brand text-white border-brand'
          : parentActive
            ? 'bg-brand-light text-brand border-brand'
            : 'bg-white text-slate-600 border-slate-200 hover:border-brand hover:text-brand');
    });
  }

  const basePath = location.pathname.replace(/\/+$/, '');
  btns.forEach((b) => {
    b.addEventListener('click', () => {
      const cat = b.dataset.cat || defaultCat;
      const url = basePath + '?cat=' + encodeURIComponent(cat);
      history.replaceState(null, '', url);
      paint(cat);
    });
  });

  // 页面加载时根据 URL 的 ?cat= 过滤（兼容导航下拉链接；无参数用默认分类）
  const initial = new URLSearchParams(location.search).get('cat') || defaultCat;
  paint(initial);
</script>
