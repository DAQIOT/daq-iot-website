---
/**
 * 荣誉资质页面
 *
 * 内容全部来自后台「页面文案 → 荣誉资质」（src/content/honors/<lang>-index.md）。
 * 入口：合作伙伴页面「资料中心」的「认证证书」卡片（该卡片配了 link: /honors，点开即跳本页）。
 *
 * 每个板块 = 一组证书图片；点任意一张打开灯箱放大，支持左右翻页 / 键盘方向键 / Esc 关闭。
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getTranslations, getSiteData } from '../../i18n/utils';
import type { Lang } from '../../i18n/config';
import PageHero from '../../components/PageHero.astro';

export function getStaticPaths() {
  return (['en', 'zh', 'de'] as Lang[]).map((lang) => ({ params: { lang } }));
}
const { lang } = Astro.params as { lang: Lang };
const t = await getTranslations(lang);
const site = await getSiteData(lang);

const honors = (site.honors ?? {}) as Record<string, any>;
const bannerImage = (site.banner?.pageImage as string) || '';
const title = (honors.title as string) || t('nav.honors');
const subtitle = (honors.subtitle as string) || '';

// 板块列表（每个板块一组图片），顺带算出每张图的全局下标，供灯箱翻页
let cursor = 0;
const sections = ((honors.sections ?? []) as any[])
  .map((s) => ({
    title: String(s?.title ?? '').trim(),
    desc: String(s?.desc ?? '').trim(),
    images: ((s?.images ?? []) as any[])
      .map((im) => ({
        src: String(im?.image ?? '').trim(),
        caption: String(im?.caption ?? '').trim()
      }))
      .filter((im) => im.src)
      .map((im) => ({ ...im, idx: cursor++ }))
  }))
  .filter((s) => s.images.length > 0);

// 灯箱用的扁平列表（顺序与页面上渲染顺序一致）
const flat = sections.flatMap((s) => s.images.map((im) => ({ src: im.src, caption: im.caption, section: s.title })));

const emptyText = lang === 'zh' ? '暂无内容' : lang === 'de' ? 'Noch keine Inhalte' : 'No content yet';
const lbClose = lang === 'zh' ? '关闭' : lang === 'de' ? 'Schliessen' : 'Close';
const lbPrev = lang === 'zh' ? '上一张' : lang === 'de' ? 'Zurueck' : 'Previous';
const lbNext = lang === 'zh' ? '下一张' : lang === 'de' ? 'Weiter' : 'Next';
---
<BaseLayout lang={lang} title={title + ' | DAQ-IOT'} description={subtitle}>
  <PageHero title={title} subtitle={subtitle} image={bannerImage} />

  {sections.length > 0 ? (
    <section class="mx-auto max-w-[1600px] px-4 lg:px-8 py-14 lg:py-20 space-y-14 lg:space-y-20">
      {sections.map((s) => (
        <div>
          <div class="mb-8">
            <h2 class="text-2xl md:text-3xl font-bold text-brand-dark">{s.title}</h2>
            {s.desc && <p class="mt-2 text-slate-500 text-sm md:text-base">{s.desc}</p>}
          </div>
          <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-5">
            {s.images.map((im) => (
              <button
                type="button"
                class="honor-card group block w-full bg-white border border-slate-200 rounded-2xl overflow-hidden card-hover"
                data-lb={im.idx}
                aria-label={im.caption || title}
              >
                <span class="block aspect-[3/4] bg-white p-3">
                  <img
                    src={im.src}
                    alt={im.caption}
                    loading="lazy"
                    decoding="async"
                    class="h-full w-full object-contain transition duration-300 group-hover:scale-[1.02]"
                  />
                </span>
                <span class="block px-4 py-3 border-t border-slate-100 bg-slate-50/60">
                  <span class="block text-sm font-medium text-slate-700 leading-snug min-h-[2.5rem]">{im.caption}</span>
                </span>
              </button>
            ))}
          </div>
        </div>
      ))}
    </section>
  ) : (
    <section class="mx-auto max-w-[1600px] px-4 lg:px-8 py-24 text-center text-slate-400">{emptyText}</section>
  )}

  <!-- 灯箱：点证书放大，左右翻页，Esc / 点背景关闭 -->
  <div id="honor-lb" class="honor-lb" hidden>
    <div class="honor-lb-backdrop" data-lb-close></div>
    <div class="honor-lb-bar">
      <span id="honor-lb-count" class="honor-lb-count"></span>
      <button type="button" class="honor-lb-x" data-lb-close aria-label={lbClose}>
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true">
          <line x1="6" y1="6" x2="18" y2="18"></line>
          <line x1="18" y1="6" x2="6" y2="18"></line>
        </svg>
      </button>
    </div>
    <button type="button" class="honor-lb-nav honor-lb-prev" data-lb-prev aria-label={lbPrev}>
      <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <polyline points="15 5 8 12 15 19"></polyline>
      </svg>
    </button>
    <figure class="honor-lb-figure">
      <img id="honor-lb-img" src="" alt="" />
      <figcaption>
        <span id="honor-lb-cap" class="honor-lb-cap"></span>
        <span id="honor-lb-sec" class="honor-lb-sec"></span>
      </figcaption>
    </figure>
    <button type="button" class="honor-lb-nav honor-lb-next" data-lb-next aria-label={lbNext}>
      <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <polyline points="9 5 16 12 9 19"></polyline>
      </svg>
    </button>
  </div>

  <script type="application/json" id="honor-lb-data" set:html={JSON.stringify(flat)} />
</BaseLayout>

<style>
  .honor-lb {
    position: fixed;
    inset: 0;
    z-index: 90;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 1rem;
  }
  .honor-lb[hidden] {
    display: none;
  }
  .honor-lb-backdrop {
    position: absolute;
    inset: 0;
    background: rgba(8, 20, 33, 0.86);
    backdrop-filter: blur(2px);
  }
  .honor-lb-bar {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 0.75rem;
    padding: 0.75rem 1rem;
    color: #e2e8f0;
  }
  .honor-lb-count {
    font-size: 0.8rem;
    letter-spacing: 0.02em;
    color: #94a3b8;
  }
  .honor-lb-x,
  .honor-lb-nav {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 9999px;
    background: rgba(255, 255, 255, 0.1);
    color: #f1f5f9;
    border: 1px solid rgba(255, 255, 255, 0.16);
    cursor: pointer;
    transition: background 0.2s ease, transform 0.2s ease;
  }
  .honor-lb-x {
    width: 36px;
    height: 36px;
  }
  .honor-lb-nav {
    position: relative;
    z-index: 1;
    width: 46px;
    height: 46px;
    flex: none;
  }
  .honor-lb-x:hover,
  .honor-lb-nav:hover {
    background: rgba(255, 255, 255, 0.22);
  }
  .honor-lb-prev {
    margin-right: 0.75rem;
  }
  .honor-lb-next {
    margin-left: 0.75rem;
  }
  .honor-lb-figure {
    position: relative;
    z-index: 1;
    margin: 0;
    max-width: min(1000px, 100%);
    max-height: calc(100vh - 7rem);
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }
  .honor-lb-figure img {
    max-height: calc(100vh - 11rem);
    width: auto;
    max-width: 100%;
    margin: 0 auto;
    object-fit: contain;
    background: #fff;
    border-radius: 0.5rem;
    box-shadow: 0 24px 60px rgba(0, 0, 0, 0.45);
  }
  .honor-lb-cap {
    display: block;
    text-align: center;
    color: #f8fafc;
    font-weight: 600;
    font-size: 0.95rem;
  }
  .honor-lb-sec {
    display: block;
    text-align: center;
    color: #94a3b8;
    font-size: 0.8rem;
    margin-top: 0.15rem;
  }
  @media (max-width: 767px) {
    .honor-lb-nav {
      position: absolute;
      bottom: 1.25rem;
      width: 40px;
      height: 40px;
    }
    .honor-lb-prev {
      left: 1.25rem;
      margin: 0;
    }
    .honor-lb-next {
      right: 1.25rem;
      margin: 0;
    }
    .honor-lb-figure {
      max-height: calc(100vh - 10rem);
    }
  }
</style>

<script>
  const root = document.getElementById('honor-lb');
  const dataEl = document.getElementById('honor-lb-data');
  if (root && dataEl) {
    const list = JSON.parse(dataEl.textContent || '[]') as { src: string; caption: string; section: string }[];
    const img = document.getElementById('honor-lb-img') as HTMLImageElement | null;
    const cap = document.getElementById('honor-lb-cap');
    const sec = document.getElementById('honor-lb-sec');
    const count = document.getElementById('honor-lb-count');
    let cur = 0;

    const render = () => {
      const it = list[cur];
      if (!it || !img) return;
      img.src = it.src;
      img.alt = it.caption;
      if (cap) cap.textContent = it.caption;
      if (sec) sec.textContent = it.section;
      if (count) count.textContent = cur + 1 + ' / ' + list.length;
    };

    const open = (i: number) => {
      if (!list.length) return;
      cur = (i + list.length) % list.length;
      render();
      root.hidden = false;
      document.documentElement.style.overflow = 'hidden';
    };

    const close = () => {
      root.hidden = true;
      document.documentElement.style.overflow = '';
    };

    const step = (d: number) => {
      cur = (cur + d + list.length) % list.length;
      render();
    };

    document.querySelectorAll<HTMLElement>('[data-lb]').forEach((el) => {
      el.addEventListener('click', () => open(Number(el.getAttribute('data-lb') || 0)));
    });
    root.querySelectorAll<HTMLElement>('[data-lb-close]').forEach((el) => el.addEventListener('click', close));
    root.querySelector<HTMLElement>('[data-lb-prev]')?.addEventListener('click', () => step(-1));
    root.querySelector<HTMLElement>('[data-lb-next]')?.addEventListener('click', () => step(1));

    document.addEventListener('keydown', (e) => {
      if (root.hidden) return;
      if (e.key === 'Escape') close();
      else if (e.key === 'ArrowLeft') step(-1);
      else if (e.key === 'ArrowRight') step(1);
    });

    // 移动端左右滑动翻页
    let startX = 0;
    root.addEventListener('touchstart', (e) => (startX = e.touches[0].clientX), { passive: true });
    root.addEventListener('touchend', (e) => {
      const dx = e.changedTouches[0].clientX - startX;
      if (Math.abs(dx) > 50) step(dx < 0 ? 1 : -1);
    });
  }
</script>
